# --- REQUIRED: ImageKit.io Configuration ---
# Get these from your dashboard at https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=your_private_key_here

# --- REQUIRED: Authentication ---
# Generate a long, random string (e.g., 'openssl rand -hex 32')
JWT_SECRET=your_secret_string_here

# --- OPTIONAL: Database ---
# Default is SQLite for local dev. Use PostgreSQL for production.
# Example for PostgreSQL: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./test.db

# --- OPTIONAL: Hosting ---
# Most cloud providers (like Heroku/Render) set this automatically.
PORT=8000

# Comma-separated CORS allowlist for browser apps (for example your Vercel frontend URL).
# Example: CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# Optional regex for preview deployments. Example:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Set to 1 only if you want backend to serve bundled static frontend from /static.
SERVE_STATIC_FRONTEND=0
